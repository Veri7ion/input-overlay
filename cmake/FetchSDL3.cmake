include(FetchContent)

set(SDL_SHARED ON CACHE BOOL "" FORCE)
set(SDL_STATIC OFF CACHE BOOL "" FORCE)
set(SDL_TEST_LIBRARY OFF CACHE BOOL "" FORCE)
set(SDL_HIDAPI ON CACHE BOOL "" FORCE)
set(SDL_HIDAPI_JOYSTICK ON CACHE BOOL "" FORCE)

FetchContent_Declare(
  SDL3
  GIT_REPOSITORY https://github.com/libsdl-org/SDL.git
  GIT_TAG 113e97e193479c137b3f5ba166b7ab37e0ed8219
  GIT_SHALLOW FALSE
)
FetchContent_MakeAvailable(SDL3)

set(SDL3_LIBRARIES SDL3::SDL3 CACHE STRING "" FORCE)
set(SDL3_INCLUDE_DIRS "" CACHE STRING "" FORCE)
if(WIN32)
  set(SDL3_DLLS "$<TARGET_FILE:SDL3::SDL3>" CACHE STRING "" FORCE)
endif()
